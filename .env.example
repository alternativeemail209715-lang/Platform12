# Copy this file to ".env" for local testing only.
# On Render, you do NOT create a .env file - you paste these as
# "Environment Variables" in the Render dashboard instead (see DEPLOY_GUIDE.md).

# Your EulerStream sign-in key. Get one free at https://www.eulerstream.com
# This is REQUIRED for a reliable connection to TikTok LIVE chat, and is
# shared by all five games on this platform. Set it under EITHER name below
# (or both, it doesn't matter) - server.js automatically mirrors whichever
# one you set onto the other at startup.
EULERSTREAM_API_KEY=
TIKTOK_SIGN_API_KEY=

# The port the server listens on. Render sets this automatically - you can
# leave this blank when deploying to Render. Only needed for local testing.
PORT=3000

# OPTIONAL - protect the HOME page's "Customize game cards" panel.
# Leave blank and anyone who can open your site can restyle the cards.
# Set any password here and saving a card design asks for it once per device.
HOME_EDIT_KEY=

# OPTIONAL (update 38) - set to 0 to stop the server from reconnecting to your TikTok LIVE by itself after a restart.
PLATFORM_AUTORESUME=1

# OPTIONAL (update 40) - where the Records archive (every gift, like, milestone...) is saved.
# Leave blank to use the data/ folder (Render's free disk is wiped on every redeploy - use Download backup after streams).
# To keep records for good: add a Render Disk, then set this to its mount path, for example /var/data
RECORDS_DIR=

# OPTIONAL (update 48): link to a plain text file of words (one per line) so Indonesian / Malay
# word games accept many more guesses. Leave empty to use the built-in lists.
# ID_DICTIONARY_URL=
# MS_DICTIONARY_URL=
